# --- MongoDB ---
# Paste your Atlas connection string. IMPORTANT: rotate the password you shared in chat.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/pta?retryWrites=true&w=majority
MONGODB_DB=pta

# --- Gmail SMTP ---
# Create an App Password at https://myaccount.google.com/apppasswords (requires 2FA on).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Promoora PTA <you@gmail.com>"

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:8080

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
